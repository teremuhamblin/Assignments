library(tidyverse)
library(Rsamtools)
library(GenomicRanges)
library(ggplot2)

# Vérification du fichier d'alignement BAM
bam_path <- "results/aligned/sample_sorted.bam"
file.exists(bam_path)

# Lecture des métriques d'alignement (idxstats)
idx_stats <- idxstatsBam(bam_path)
head(idx_stats)

# Calcul du taux d'alignement (Mapping rate)
total_reads <- sum(idx_stats$mapped + idx_stats$unmapped)
mapped_reads <- sum(idx_stats$mapped)
mapping_rate <- (mapped_reads / total_reads) * 100
cat("Taux d'alignement :", round(mapping_rate, 2), "%\n")

# Calcul de la couverture moyenne
bam_header <- scanBamHeader(bam_path)
seq_lengths <- bam_header[[1]]$targets
depth_data <- read.table("results/aligned/coverage.bed", header=FALSE, col.names=c("chr", "start", "end", "depth"))

# Visualisation de la distribution de couverture
p <- ggplot(depth_data, aes(x = depth)) +
  geom_histogram(binwidth = 2, fill = "#2C3E50", color = "white", alpha = 0.8) +
  theme_minimal() +
  labs(title = "Distribution de la profondeur de séquençage",
       x = "Profondeur (X)",
       y = "Nombre de fenêtres génomiques")

# Sauvegarde de la figure
ggsave("results/figures/coverage_distribution.png", plot = p, width = 8, height = 5, dpi = 300)
q()
